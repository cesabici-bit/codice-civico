# ==============================================================================
# Codice Civico — Environment Variables
# Copy to .env and fill in real values before deploying.
# ==============================================================================

# === Database ===
POSTGRES_DB=codicecivico
POSTGRES_USER=codicecivico
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
CC_DATABASE_URL=postgresql+asyncpg://codicecivico:CHANGE_ME_STRONG_PASSWORD_HERE@postgres:5432/codicecivico

# === API ===
CC_API_HOST=0.0.0.0
CC_API_PORT=8000
CC_API_PREFIX=/api/v1
CC_CORS_ORIGINS=["http://YOUR_SERVER_IP"]
CC_LOG_LEVEL=INFO

# === Ollama (LLM Translation) ===
CC_OLLAMA_URL=http://ollama:11434
CC_OLLAMA_MODEL=swap/LLaMAntino-3-ANITA-8B-Inst-DPO-ITA-GGUF

# === Scheduler ===
CC_SCHEDULER_ENABLED=true

# === Data Sources (defaults should work, override if needed) ===
# CC_CAMERA_SPARQL_ENDPOINT=https://dati.camera.it/sparql
# CC_SENATO_SPARQL_ENDPOINT=https://dati.senato.it/sparql
# CC_ANAC_DATA_URL=https://dati.anticorruzione.it/opendata
# CC_GIUSTIZIA_STATS_URL=https://datiestatistiche.giustizia.it
